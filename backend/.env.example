# MongoDB connection string
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# JWT signing secret (required)
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime (minutes) and refresh token lifetime (days)
# JWT_EXPIRES_MINUTES=60
# REFRESH_TOKEN_DAYS=30

# Gemini AI API key (used by /api/ai endpoints)
# GEMINI_API_KEY=your-key
# GEMINI_MODEL=gemini-3.6-flash

# --- Google Sign-In ("Continue with Google") ---
# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Password-reset email (SMTP) ---
# When SMTP_HOST is set, reset emails are sent over SMTP.
# When it is unset, the reset link is returned in the API response as
# "dev_reset_link" so the flow can be tested locally.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=CivicLens AI <noreply@example.com>

# Frontend base URL used when building password-reset links
# FRONTEND_URL=http://localhost:4200

# Password-reset token lifetime (hours)
# RESET_TOKEN_HOURS=1